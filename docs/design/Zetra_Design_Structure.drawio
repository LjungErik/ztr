        <mxCell id="ThP1wO_oMD2ZlEkIRo7K-7" value="&lt;div&gt;PCAP-Packet&lt;/div&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
