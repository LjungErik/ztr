        <mxCell id="rg6_OEJosYoxhmM72Cas-14" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Worker Nodes&lt;/h1&gt;&lt;p&gt;Allows the distribution of scans and other tasks among several workers. The workers can also be marked with specific TAGS to help determine which workers are best suited for specific tasks.&lt;br&gt;&lt;br&gt;workers can also perform passive scanning, where they just listen to active traffic and help the rest of the network to map out the overall infrastructure.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="530" width="180" height="250" as="geometry" />
        </mxCell>
        <mxCell id="rg6_OEJosYoxhmM72Cas-15" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Backend API&lt;/h1&gt;&lt;p&gt;A Backend API that allows the UI and CLI to perform specific tasks like network scans, vulenerability scans, and worm based exploitation&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="550" y="317.5" width="180" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rg6_OEJosYoxhmM72Cas-16" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;UI&lt;/h1&gt;&lt;p&gt;A user friendly interface to make it easier work with large scale scans and also manage scheduled tasks.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="550" y="160" width="180" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rg6_OEJosYoxhmM72Cas-17" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;CLI&lt;/h1&gt;&lt;p&gt;Simple CLI tool to allow onetime scans or to observer running scans without needing to go to the UI. Can be used for local automation task and allow advanced users to easily interface with the system&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="110" y="180" width="180" height="162.5" as="geometry" />
        </mxCell>
        <mxCell id="rg6_OEJosYoxhmM72Cas-18" value="Persistence Storage" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="460" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rg6_OEJosYoxhmM72Cas-20" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Consensus Protocol&lt;/h1&gt;&lt;p&gt;Internal protocol to allow individual nodes to be deployed freely in the network and though network connectivity be able to connect and agree on leader election.&amp;nbsp;&lt;br&gt;&lt;br&gt;One potential option here is to use RAFT for consensus.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="160" y="450" width="180" height="230" as="geometry" />
        </mxCell>
      </root>
